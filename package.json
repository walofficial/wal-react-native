    "postinstall": "patch-package",
    "feature:start": "bash ./scripts/gitflow-feature-start.sh",
    "feature:finish": "bash ./scripts/gitflow-feature-finish.sh",
    "release:start": "bash ./scripts/gitflow-release-start.sh",
